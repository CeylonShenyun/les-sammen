{
  "title": "书房",
  "subtitle": "Bibliotek",
  "ai_name": "Claude",
  "reader": "她",
  "host": "127.0.0.1",
  "port": 18050,
  "mcp_name": "bibliotek",
  "data_dir": "data",
  "back_url": "",
  "background": "/assets/bg.webp",
  "study_rooms": false,
  "alphabet": "abcdefghijklmnopqrstuvwxyz",
  "tz_hours": 8,
  "max_upload_mb": 200,

  "companion": {
    "mode": "claude_p",
    "hint": null,
    "attach_page": null,

    "claude_p": {
      "bin": "claude",
      "cwd": "",
      "session_id": "",
      "attach_mcp": true,
      "args": ["--max-turns", "8"],
      "timeout": 600
    },

    "api": {
      "model": "claude-opus-5",
      "api_key": "env:ANTHROPIC_API_KEY",
      "base_url": "",
      "max_tokens": 16000,
      "fallbacks": true,
      "history_turns": 20,
      "system_file": ""
    },

    "openai": {
      "base_url": "https://api.deepseek.com/v1",
      "api_key": "env:OPENAI_API_KEY",
      "model": "deepseek-chat",
      "max_tokens": null,
      "max_tokens_field": "max_tokens",
      "history_turns": 20,
      "system_file": "",
      "extra": {},
      "timeout": 600
    },

    "http": {
      "url": "http://127.0.0.1:3456/v1/messages",
      "format": "anthropic",
      "model": "claude-opus-5",
      "headers": { "x-api-key": "env:BRIDGE_API_KEY" },
      "reply_field": "reply",
      "timeout": 900
    },

    "command": {
      "cmd": ["python3", "examples/sdk_reply.py"],
      "timeout": 600
    }
  }
}
